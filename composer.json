{
    "name": "otghcloud/laravel-whois",
    "description": "Laravel package for providing WHOIS/RDAP lookups",
    "keywords": [
        "otghcloud",
        "laravel",
        "laravel-whois"
    ],
    "homepage": "https://github.com/otghcloud/laravel-whois",
    "license": "MIT",
    "authors": [
        {
            "name": "OTGH Cloud",
            "email": "open-source@otgh.cloud",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "jeremykendall/php-domain-parser": "^6.0",
        "nesbot/carbon": "^3.11",
        "symfony/polyfill-intl-idn": "^1.32"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "nunomaduro/collision": "^8.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "OTGH\\LaravelWhois\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },

    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OTGH\\LaravelWhois\\LaravelWhoisServiceProvider"
            ],
            "aliases": {
                "LaravelWhois": "OTGH\\LaravelWhois\\Facades\\LaravelWhois"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
